exports[`zod format guard — @labre/store > baseTextAttributes 1`] = `
{
  "a wrong link is caught": {
    "data": {
      "link": undefined,
    },
    "success": true,
  },
  "a wrong value is caught to undefined": {
    "data": {
      "bold": undefined,
      "italic": undefined,
    },
    "success": true,
  },
  "empty": {
    "data": {},
    "success": true,
  },
  "every base mark": {
    "data": {
      "bold": true,
      "code": true,
      "italic": true,
      "link": "https://example.com",
      "strike": true,
      "underline": true,
    },
    "success": true,
  },
  "explicit undefined": {
    "data": {
      "bold": undefined,
    },
    "success": true,
  },
  "null clears a mark": {
    "data": {
      "bold": null,
      "link": null,
    },
    "success": true,
  },
  "unknown keys are stripped": {
    "data": {},
    "success": true,
  },
}
`;
