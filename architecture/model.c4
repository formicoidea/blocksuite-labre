// Hand-written half of the library's architecture map (ADR 0040): the
// element and relationship kinds, and the views. Every element and relation
// lives in code.c4, generated by `yarn architecture`; a view here selects
// them by predicate (kind, scope, wildcard), never by naming a package or a
// folder, so a new package shows up without touching this file.
specification {
  element layer {
    notation 'Layer: uses the layers below it, never above'
    style {
      color slate
      opacity 10%
      border dashed
    }
  }
  element family {
    notation 'Package family: packages/affine/<kind>'
    style {
      color slate
      opacity 20%
    }
  }
  element package {
    notation 'Workspace package'
    style {
      color primary
    }
  }
  element folder {
    notation 'Folder under the package src/'
    style {
      color secondary
      size small
    }
  }
  relationship uses {
    notation 'Package imports package (count of imported files)'
    color primary
  }
  relationship imports {
    notation 'Folder imports folder (count of imported files)'
    color gray
    line dotted
  }
}

views {
  // A view of packages excludes `imports` (folder to folder): those
  // relations stay in the model for the relationship browser and the MCP
  // tools, but would double every package edge on the diagram.
  view index {
    title 'blocksuite-labre: layers'
    description 'Four layers, one direction, and the tooling above them. Click a layer to zoom.'
    include *
    exclude * -> * where kind is imports
    autoLayout BottomTop
  }

  view layer-framework of framework {
    title 'framework/*'
    include *
    exclude * -> * where kind is imports
  }

  // A layer of one package shows that package's folders instead.
  view layer-model of model_ {
    title 'affine/model'
    description 'The file format, folder by folder.'
    include model_.**
  }

  view layer-features of features {
    title 'affine/* features'
    description 'Package families and standalone feature packages.'
    include *
    exclude * -> * where kind is imports
  }

  view family-blocks of features.blocks {
    title 'affine/blocks'
    include *
    exclude * -> * where kind is imports
  }

  view family-fragments of features.fragments {
    title 'affine/fragments'
    include *
    exclude * -> * where kind is imports
  }

  view family-gfx of features.gfx {
    title 'affine/gfx'
    include *
    exclude * -> * where kind is imports
  }

  view family-inlines of features.inlines {
    title 'affine/inlines'
    include *
    exclude * -> * where kind is imports
  }

  view family-widgets of features.widgets {
    title 'affine/widgets'
    include *
    exclude * -> * where kind is imports
  }

  view layer-assembly of assembly {
    title 'affine/all'
    description 'The assembly, folder by folder.'
    include assembly.**
  }

  view layer-tooling of tooling {
    title 'tooling'
    include *
    exclude * -> * where kind is imports
  }
}
