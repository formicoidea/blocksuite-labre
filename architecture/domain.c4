views {
  view domain-canvas {
    title 'Domain: canvas'
    description 'The edgeless whiteboard: surface, shapes, connectors, frames, mind maps, layers, the canvas toolbars. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'canvas'
    exclude * -> * where kind is imports
  }
  view domain-database {
    title 'Domain: database'
    description 'Database and data-view blocks: tables, kanban, properties, views. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'database'
    exclude * -> * where kind is imports
  }
  view domain-document-model {
    title 'Domain: document-model'
    description 'The document model and its persistence: store, sync, schemas and element models (the file format). Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'document-model'
    exclude * -> * where kind is imports
  }
  view domain-editor-runtime {
    title 'Domain: editor-runtime'
    description 'The editor runtime shared by both views: DI, commands, selection, events, clipboard, widgets plumbing. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'editor-runtime'
    exclude * -> * where kind is imports
  }
  view domain-frameworks {
    title 'Domain: frameworks'
    description 'Business notations drawn on the canvas: Wardley, EDGY, BPMN, C4, Cynefin, UML, DDD. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'frameworks'
    exclude * -> * where kind is imports
  }
  view domain-host-seams {
    title 'Domain: host-seams'
    description 'What the host fills: telemetry, translation, notifications, image proxy, link preview. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'host-seams'
    exclude * -> * where kind is imports
  }
  view domain-interchange {
    title 'Domain: interchange'
    description 'Import and export: Markdown, HTML, SVG and notation interchange formats. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'interchange'
    exclude * -> * where kind is imports
  }
  view domain-prose {
    title 'Domain: prose'
    description 'Page editing: rich text, inline elements, paragraph, list, code, callout and other page blocks. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'prose'
    exclude * -> * where kind is imports
  }
  view domain-tooling {
    title 'Domain: tooling'
    description 'Playground, integration suite and test helpers. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'tooling'
    exclude * -> * where kind is imports
  }
}
