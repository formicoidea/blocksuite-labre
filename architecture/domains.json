  "domains": {
    "base-view": "Base views: database and data-view blocks, tables, kanban, properties.",
    "canvas": "The canvas: basic shapes, connectors, brush, mind maps, the drawing tools, the business frameworks (Wardley, C4, EDGY, BPMN, Cynefin, UML, DDD) and templates, and their notation tooling: validation rules and profiles, nudges, map quality, legends, violation timeline, audit.",
    "collaboration": "Working together: sync and awareness, remote selections, comments and thread marks.",
    "document": "The document: its model and file format, rich text, inline elements and page blocks.",
    "file": "Files: attachments and images, blobs, import and export (Markdown, HTML, SVG, draw.io, notation formats).",
    "layer": "User layers: active layer, shared and local hide, the selection pane.",
    "presentation": "Presenting and running a workshop: frames, the presentation mode and slideshow, the frame panel, the reading frame, spotlight, public pages, workshop facilitation widgets and, later, sites."
