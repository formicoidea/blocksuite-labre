views {
  view domain-base-view {
    title 'Domain: base-view'
    description 'Base views: database and data-view blocks, tables, kanban, properties. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'base-view'
    exclude * -> * where kind is imports
  }
  view domain-canvas {
    title 'Domain: canvas'
    description 'The canvas: basic shapes, connectors, brush, mind maps, the drawing tools, the business frameworks (Wardley, C4, EDGY, BPMN, Cynefin, UML, DDD) and templates. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'canvas'
    exclude * -> * where kind is imports
  }
  view domain-collaboration {
    title 'Domain: collaboration'
    description 'Working together: sync and awareness, remote selections, comments and thread marks. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'collaboration'
    exclude * -> * where kind is imports
  }
  view domain-document {
    title 'Domain: document'
    description 'The document: its model and file format, rich text, inline elements and page blocks. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'document'
    exclude * -> * where kind is imports
  }
  view domain-file {
    title 'Domain: file'
    description 'Files: attachments and images, blobs, import and export (Markdown, HTML, SVG, draw.io, notation formats). Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'file'
    exclude * -> * where kind is imports
  }
  view domain-layer {
    title 'Domain: layer'
    description 'User layers: active layer, shared and local hide, the selection pane. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'layer'
    exclude * -> * where kind is imports
  }
  view domain-presentation {
    title 'Domain: presentation'
    description 'Presenting: frames, the presentation mode, the frame panel, the reading frame and spotlight. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'presentation'
    exclude * -> * where kind is imports
  }
  view domain-workshop {
    title 'Domain: workshop'
    description 'Running a workshop on a board: validation rules and profiles, nudges, map quality, legends, violation timeline, audit. Scored overlay (domains.json), not a parent.'
    include * where metadata.domain is 'workshop'
    exclude * -> * where kind is imports
  }
}
