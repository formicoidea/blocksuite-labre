        "ecosystem": {
          "override": {
            "line": {
              "color": "#7c3aed",
              "dash": "8 4"
            }
          }
        },
        "late": {
          "override": {
            "line": {
              "color": "#d97706",
              "dash": "2 2"
            }
          }
        },
        "default": {
          "override": {
            "line": {
              "color": "#64748b"
            }
          }
        }
      },
      "legend": {
        "default": {
          "box": {
            "position": "top-right"
          }
        }
      },
      "background": {
        "canvas": {
          "default": {
            "width": 1600,
            "height": 900,
            "fill": "#fafafa"
          }
        },
        "axisValueChain": {
          "default": {
            "label": {
              "text": "Chaine de valeur"
            }
          }
        },
        "phases": {
          "default": {
            "labels": [
              {
                "text": "Genese"
              },
              {
                "text": "Sur-mesure"
              },
              {
                "text": "Produit"
              },
              {
                "text": "Commodity"
              }
            ]
          }
        }
      },
      "nodes": {
        "default": {
          "override": {
            "symbol": {
              "radius": 5,
              "stroke": "#334155"
            }
          }
        },
        "bySubtype": {
          "userNeed": {
            "override": {
              "symbol": {
                "radius": 7,
                "stroke": "#dc2626"
              }
            }
          },
          "market": {
            "override": {
              "symbol": {
                "radius": 8,
                "stroke": "#059669"
              }
            }
          },
          "ecosystem": {
            "override": {
              "symbol": {
                "radius": 10,
                "stroke": "#7c3aed"
              }
            }
          },
          "note": {
            "override": {
              "symbol": {
                "stroke": "#94a3b8"
              }
            }
          }
