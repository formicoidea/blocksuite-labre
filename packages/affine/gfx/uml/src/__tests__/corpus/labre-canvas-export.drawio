<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Labre">
  <diagram id="labre-canvas" name="Shop">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <object id="slide" label="Orders" labre-type="affine:frame">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontStyle=1;fillColor=none;" vertex="1" parent="1">
            <mxGeometry x="-20" y="-20" width="1040" height="740" as="geometry" />
          </mxCell>
        </object>
        <object id="sheet" label="Shop" labre-type="umlDiagram" labre-role="uml:diagram">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
            <mxGeometry x="0" y="0" width="1000" height="700" as="geometry" />
          </mxCell>
        </object>
        <object id="order-group" label="" labre-type="group">
          <mxCell style="group;html=1;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="100" y="100" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="order" label="" labre-type="umlNode" labre-role="uml:class">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="order-group">
            <mxGeometry x="0" y="0" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="order-attributes" label="+ id : int&lt;br&gt;+ total : float" labre-type="text" labre-role="uml:attributes">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="order-group">
            <mxGeometry x="8" y="40" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="order-name" label="Order" labre-type="text" labre-role="uml:name">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="order-group">
            <mxGeometry x="8" y="8" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="order-operations" label="+ pay() : void" labre-type="text" labre-role="uml:operations">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="order-group">
            <mxGeometry x="8" y="80" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="payable-group" label="" labre-type="group">
          <mxCell style="group;html=1;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="500" y="100" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="payable" label="" labre-type="umlNode" labre-role="uml:interface">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="payable-group">
            <mxGeometry x="0" y="0" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="payable-attributes" label="" labre-type="text" labre-role="uml:attributes">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="payable-group">
            <mxGeometry x="8" y="40" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="payable-name" label="Payable" labre-type="text" labre-role="uml:name">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="payable-group">
            <mxGeometry x="8" y="8" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="payable-operations" label="+ pay() : void" labre-type="text" labre-role="uml:operations">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="payable-group">
            <mxGeometry x="8" y="80" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="item-group" label="" labre-type="group">
          <mxCell style="group;html=1;" vertex="1" connectable="0" parent="1">
            <mxGeometry x="100" y="400" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="item" label="" labre-type="umlNode" labre-role="uml:class">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="item-group">
            <mxGeometry x="0" y="0" width="200" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="item-attributes" label="+ sku : string" labre-type="text" labre-role="uml:attributes">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="item-group">
            <mxGeometry x="8" y="40" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="item-name" label="Item" labre-type="text" labre-role="uml:name">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;" vertex="1" parent="item-group">
            <mxGeometry x="8" y="8" width="184" height="24" as="geometry" />
          </mxCell>
        </object>
        <object id="sticky" label="Ask the &amp;lt;b&amp;gt;team&amp;lt;/b&amp;gt; &amp;amp; &amp;quot;legal&amp;quot;" labre-type="shape">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=16;fillColor=#FFDF6B;strokeColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="700" y="400" width="160" height="80" as="geometry" />
          </mxCell>
        </object>
        <object id="caption" label="Draft, v2" labre-type="text">
          <mxCell style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=20;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
            <mxGeometry x="40" y="620" width="200" height="30" as="geometry" />
          </mxCell>
        </object>
        <object id="memo" label="Payment is async&lt;br&gt;see ADR" labre-type="affine:note">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF4D8;strokeColor=none;spacing=12;" vertex="1" parent="1">
            <mxGeometry x="700" y="100" width="240" height="120" as="geometry" />
          </mxCell>
        </object>
        <object id="logo" label="Logo" labre-type="affine:image" labre-image="abc123">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;" vertex="1" parent="1">
            <mxGeometry x="700" y="560" width="80" height="60" as="geometry" />
          </mxCell>
        </object>
        <object id="realizes" label="" labre-type="connector" labre-role="uml:realization">
          <mxCell style="html=1;edgeStyle=none;startArrow=none;startFill=0;endArrow=block;endFill=0;strokeColor=#000000;strokeWidth=2;dashed=1;" edge="1" parent="1" source="order" target="payable">
            <mxGeometry relative="1" as="geometry">
              <mxPoint x="300" y="160" as="sourcePoint" />
              <mxPoint x="500" y="160" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </object>
        <object id="contains" label="lines" labre-type="connector" labre-role="uml:composition">
          <mxCell style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;startArrow=diamond;startFill=1;endArrow=none;endFill=0;strokeColor=#000000;strokeWidth=2;" edge="1" parent="1" source="order" target="item">
            <mxGeometry relative="1" as="geometry">
              <mxPoint x="200" y="220" as="sourcePoint" />
              <mxPoint x="200" y="400" as="targetPoint" />
              <Array as="points">
                <mxPoint x="200" y="310" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="contains-source-label" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="contains">
          <mxGeometry x="-1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="contains-target-label" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="contains">
          <mxGeometry x="1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <object id="pointer" label="" labre-type="connector">
          <mxCell style="html=1;curved=1;startArrow=none;startFill=0;endArrow=open;endFill=0;" edge="1" parent="1" source="sticky">
            <mxGeometry relative="1" as="geometry">
              <mxPoint x="780" y="480" as="sourcePoint" />
              <mxPoint x="900" y="650" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
